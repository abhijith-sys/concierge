  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing           Listing                   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([listingId, createdAt])
  @@index([userId])
  @@index([status, createdAt])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  businessId String   @db.Uuid
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId, createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Asset {
  id           String          @id @default(uuid()) @db.Uuid
  storageKey   String          @unique
  mimeType     String
  byteSize     Int
  checksum     String?
  visibility   AssetVisibility @default(public)
  status       AssetStatus     @default(ready)
  uploadedById String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  uploadedBy   User?           @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants     AssetVariant[]
  attachments  Attachment[]

  @@index([uploadedById, createdAt])
  @@index([visibility, status])
}

model AssetVariant {
  id         String @id @default(uuid()) @db.Uuid
  assetId    String @db.Uuid
  kind       String
  storageKey String @unique
  width      Int?
  height     Int?
  asset      Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, kind])
}

model Attachment {
  id         String               @id @default(uuid()) @db.Uuid
  assetId    String               @db.Uuid
  entityType AttachmentEntityType
  entityId   String               @db.Uuid
  purpose    AttachmentPurpose
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  asset      Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, purpose, assetId])
  @@index([entityType, entityId, purpose])
  @@index([assetId])
}
