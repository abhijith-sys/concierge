generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  business
  admin
}

enum BusinessStatus {
  pending
  active
  rejected
  suspended
  deleted
}

enum OtpChannel {
  email
  sms
}

enum OtpPurpose {
  register
  login
  change
  reset
  recovery
}

enum VerificationStatus {
  draft
  submitted
  approved
  rejected
}

enum AssetVisibility {
  public
  private
}

enum AssetStatus {
  pending
  ready
  rejected
  deleted
}

enum AttachmentEntityType {
  user
  business
  listing
  service
  verification
  review
  message
  field_value
  category
}

enum AttachmentPurpose {
  avatar
  logo
  cover
  gallery
  background
  banner
  kyc_owner
  kyc_location
  kyc_storefront
  kyc_document
  kyc_selfie
  kyc_video
  review_photo
  message_file
  field
}

enum CategoryFieldType {
  text
  textarea
  number
  boolean
  select
  multiselect
  date
  url
  phone
  email
  json
  asset_ref
  asset_gallery
}

enum CategoryFieldScope {
  listing
  service
  business
}

enum ServiceApprovalStatus {
  draft
  pending
  approved
  rejected
}

enum StayEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum RentalEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum TravelEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum EventEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum LogisticsEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum EducationEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum HealthEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum ProfessionalEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum HomeTradeEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum AutomotiveEnquiryStatus {
  new
  viewed
  responded
  closed
}

enum ElectronicsEnquiryStatus {
  new
  viewed
  responded
  closed
}

/// Supplier shops/wholesalers vs individual tradespeople.
enum CategoryKind {
  supplier
  service
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  name                      String
  email                     String                  @unique
  phone                     String?
  passwordHash              String
  role                      Role                    @default(user)
  emailVerifiedAt           DateTime?
  phoneVerifiedAt           DateTime?
  recoveryEmail             String?
  recoveryEmailVerifiedAt   DateTime?
  avatarUrl                 String?
  mfaEnabled                Boolean                 @default(false)
  disabledAt                DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  businesses                Business[]
  reviews                   Review[]
  otpChallenges             VerificationChallenge[]
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]              @relation("AuditActor")
  userRoles                 UserRole[]
  assignedRoles             UserRole[]              @relation("RoleAssigner")
  uploadedAssets            Asset[]                 @relation("AssetUploader")
  wishlistItems             WishlistItem[]
  stayEnquiries             StayEnquiry[]
  rentalEnquiries           RentalEnquiry[]
  travelEnquiries           TravelEnquiry[]
  eventEnquiries            EventEnquiry[]
  logisticsEnquiries        LogisticsEnquiry[]
  educationEnquiries        EducationEnquiry[]
  healthEnquiries           HealthEnquiry[]
  professionalEnquiries     ProfessionalEnquiry[]
  homeTradeEnquiries        HomeTradeEnquiry[]
  automotiveEnquiries       AutomotiveEnquiry[]
  electronicsEnquiries      ElectronicsEnquiry[]

  @@index([role])
  @@index([recoveryEmail])
}

/// RBAC permission catalog (stable string keys).
model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

/// Named role independent of legacy User.role enum.
model RoleDef {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         RoleDef    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RoleDef  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
}

model VerificationChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  parentId    String?         @db.Uuid
  description String?
  icon        String?
  /// Home / industry card background.
  imageUrl    String?
  /// Listings page hero banner.
  bannerUrl   String?
  kind        CategoryKind    @default(supplier)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  parent      Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]      @relation("CategoryTree")
  listings    Listing[]
  services    Service[]
  fields      CategoryField[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@index([kind])
}

model Business {
  id             String                   @id @default(uuid()) @db.Uuid
  ownerId        String                   @db.Uuid
  name           String
  slug           String                   @unique
  email          String
  phone          String?
  logoUrl        String?
  coverUrl       String?
  socialLinks    Json?
  verified           Boolean                  @default(false)
  status             BusinessStatus           @default(pending)
  rejectionReason    String?
  formSchemaVersion  Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  owner          User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  listing        Listing?
  reviews        Review[]
  services       Service[]
  verifications  VerificationSubmission[]
  stayEnquiries  StayEnquiry[]
  rentalEnquiries RentalEnquiry[]
  travelEnquiries TravelEnquiry[]
  eventEnquiries EventEnquiry[]
  logisticsEnquiries LogisticsEnquiry[]
  educationEnquiries EducationEnquiry[]
  healthEnquiries HealthEnquiry[]
  professionalEnquiries ProfessionalEnquiry[]
  homeTradeEnquiries HomeTradeEnquiry[]
  automotiveEnquiries AutomotiveEnquiry[]
  electronicsEnquiries ElectronicsEnquiry[]

  @@index([ownerId])
  @@index([status, verified])
}

model Listing {
  id          String              @id @default(uuid()) @db.Uuid
  businessId  String              @unique @db.Uuid
  categoryId  String              @db.Uuid
  title       String
  description String
  address     String
  city        String
  lat         Float?
  lng         Float?
  hours       Json?
  images      String[]
  website     String?
  avgRating   Float               @default(0)
  reviewCount Int                 @default(0)
  featured    Boolean             @default(false)
  /// Copied from Category.kind at create so retagging a category does not rewrite existing shops.
  listingKind   CategoryKind        @default(supplier)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fieldValues   ListingFieldValue[]
  wishlistItems WishlistItem[]
  stayEnquiries StayEnquiry[]
  rentalEnquiries RentalEnquiry[]
  travelEnquiries TravelEnquiry[]
  eventEnquiries EventEnquiry[]
  logisticsEnquiries LogisticsEnquiry[]
  educationEnquiries EducationEnquiry[]
  healthEnquiries HealthEnquiry[]
  professionalEnquiries ProfessionalEnquiry[]
  homeTradeEnquiries HomeTradeEnquiry[]
  automotiveEnquiries AutomotiveEnquiry[]
  electronicsEnquiries ElectronicsEnquiry[]

  @@index([categoryId])
  @@index([city])
  @@index([avgRating])
  @@index([featured])
  @@index([lat, lng])
  @@index([listingKind])
}

model Service {
  id                String                @id @default(uuid()) @db.Uuid
  businessId        String                @db.Uuid
  categoryId        String?               @db.Uuid
  name              String
  description       String
  price             Decimal               @db.Decimal(10, 2)
  currency          String                @default("USD") @db.VarChar(3)
  pricingType       String?
  durationMinutes   Int?
  images            String[]
  isActive          Boolean               @default(true)
  approvalStatus    ServiceApprovalStatus @default(approved)
  rejectionReason   String?
  formSchemaVersion Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fieldValues       ServiceFieldValue[]

  @@index([businessId, isActive])
  @@index([businessId, approvalStatus])
  @@index([approvalStatus])
  @@index([name])
}

model CategoryField {
  id                String                 @id @default(uuid()) @db.Uuid
  categoryId        String                 @db.Uuid
  key               String
  label             String
  helpText          String?
  placeholder       String?
  fieldType         CategoryFieldType
  required          Boolean                @default(false)
  defaultValue      Json?
  options           Json?
  validation        Json?
  conditionalRules  Json?
  scope             CategoryFieldScope     @default(listing)
  sortOrder         Int                    @default(0)
  section           String?
  isFilterable      Boolean                @default(false)
  isSearchable      Boolean                @default(false)
  isActive          Boolean                @default(true)
  schemaVersion     Int                    @default(1)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listingValues     ListingFieldValue[]
  serviceValues     ServiceFieldValue[]

  @@unique([categoryId, key])
  @@index([categoryId, scope, sortOrder])
  @@index([isActive])
}

model ListingFieldValue {
  id          String        @id @default(uuid()) @db.Uuid
  listingId   String        @db.Uuid
  fieldId     String        @db.Uuid
  valueText   String?
  valueNumber Decimal?      @db.Decimal(18, 4)
  valueBool   Boolean?
  valueJson   Json?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  listing     Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  field       CategoryField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([listingId, fieldId])
  @@index([fieldId])
}

model ServiceFieldValue {
  id          String        @id @default(uuid()) @db.Uuid
  serviceId   String        @db.Uuid
  fieldId     String        @db.Uuid
  valueText   String?
  valueNumber Decimal?      @db.Decimal(18, 4)
  valueBool   Boolean?
  valueJson   Json?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  field       CategoryField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([serviceId, fieldId])
  @@index([fieldId])
}

model VerificationSubmission {
  id               String             @id @default(uuid()) @db.Uuid
  businessId       String             @db.Uuid
  status           VerificationStatus @default(draft)
  ownerPhotoUrl    String?
  locationPhotoUrl String?
  storefrontPhotoUrl String?
  documentUrl      String?
  selfieUrl        String?
  videoUrl         String?
  reviewerId       String?            @db.Uuid
  reviewNotes      String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([status, submittedAt])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model StayEnquiry {
  id              String            @id @default(uuid()) @db.Uuid
  businessId      String            @db.Uuid
  listingId       String            @db.Uuid
  userId          String?           @db.Uuid
  guestName       String
  guestEmail      String
  guestPhone      String?
  checkIn         DateTime          @db.Date
  checkOut        DateTime          @db.Date
  adults          Int
  children        Int               @default(0)
  notes           String?
  roomSelections  Json
  status          StayEnquiryStatus @default(new)
  ownerNote       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing         Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([listingId, createdAt])
  @@index([userId])
  @@index([status, createdAt])
