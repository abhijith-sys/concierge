# Postgres
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
DATABASE_URL=postgresql://concierge:concierge@db:5432/concierge?schema=public

# API
# API_PORT is used for local development. Docker keeps the internal API on 3001.
API_PORT=3001
# Replace this value outside local development.
JWT_SECRET=dev-change-me-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
COOKIE_SECURE=false
# Idempotent demo seed on API startup; set false in production.
RUN_SEED=true
# Optional in-memory rate limiter (false by default; auto-on in production).
RATE_LIMIT_ENABLED=false
# Block sensitive actions until email OTP verified (auto-on in production).
REQUIRE_EMAIL_VERIFICATION=false
# Transactional email (Gmail SMTP). Leave blank to log OTPs instead of sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=arjp169@gmail.com
SMTP_PASS=
SMTP_FROM=
# Local upload directory (Docker mounts uploads volume at /app/uploads).
UPLOAD_ROOT=uploads
LOG_LEVEL=info

# Web (leave empty when served same-origin via nginx)
VITE_API_URL=
# Host port mapped to public nginx (change if 8080 is already in use)
WEB_PORT=8080
# Isolated Super Admin SPA
ADMIN_PORT=8081
ADMIN_APP_ORIGIN=http://localhost:8081
VITE_ADMIN_URL=http://localhost:8081

# Seeded demo credentials (local development only)
# user@demo.com / Concierge123!
# business@demo.com / Concierge123!
# admin@demo.com / Concierge123!
